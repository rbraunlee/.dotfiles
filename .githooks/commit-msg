#!/bin/sh
#
# Enforce Conventional Commits on the subject line.
#
#   <type>(<scope>): <subject>
#
# Only the FIRST line is checked. Bodies, footers and BREAKING CHANGE footers
# are conventions this hook cannot enforce and does not try to.
#
# Enabled per-clone via:  git config core.hooksPath .githooks
# That setting is local git config and is NOT committed, so it must be run once
# in every new clone or this hook never fires.
#
# Escape hatch: git commit --no-verify

pattern='^(feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert)(\([a-z0-9._/,()-]+\))?!?: .{1,100}$'

types='feat fix chore docs refactor test perf build ci style revert'

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# First non-blank, non-comment line.
subject=$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -1)
[ -n "$subject" ] || exit 0

# Let git's own auto-generated messages through. `git revert` and `git merge`
# write these and there is no way to reword them, so rejecting them would just
# force --no-verify on every merge.
#
# Note the trailing space in each pattern: a subject that is literally "merge"
# with nothing after it does NOT match, which is correct. That is a hand-written
# message and should be rejected.
case "$subject" in
    Merge\ *|Revert\ *|merge\ *|revert\ *)
        exit 0
        ;;
esac

if printf '%s' "$subject" | grep -Eq "$pattern"; then
    exit 0
fi

cat >&2 <<EOF

  Commit message does not follow Conventional Commits.

  Expected:  <type>(<scope>): <subject>
  Types:     $types
  Example:   fix(nvim): port treesitter spec to the main branch API

  Got:       $subject

  The optional scope names the stow package, and may list several:
    fix(nvim): ...        fix(zsh,hypr): ...        fix: ...

  Bypass:    git commit --no-verify

EOF
exit 1