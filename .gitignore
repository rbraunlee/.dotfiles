.env
# Root notes stay local by default; select only the active three for Git.
# Anchor this rule so package-local historical docs can be tracked normally.
/docs/*
!/docs/workflow-plan.md
!/docs/alignment.md
!/docs/CONTEXT.md
plan.md

# OpenCode local service credentials - never commit
service.json

# npm dependencies (belt-and-braces; the nested rule lives in
# common/opencode/.config/opencode/.gitignore)
node_modules/

# GIMP project sources - the exported PNGs are canonical
*.xcf
