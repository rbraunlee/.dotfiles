#!/bin/bash

# Use the full path to nvim (Check 'which nvim' to verify this path)
# If you used Homebrew, it's usually /opt/homebrew/bin/nvim
NVIM_BIN="/opt/homebrew/bin/nvim"

noteDir="/Volumes/ssd/obsidian_vault/Daily"
noteFilename="$noteDir/$(date +%Y-%m-%d).md"

# 1. Critical: Check if the SMB is actually there
if [ ! -d "/Volumes/ssd" ]; then
    echo "Error: SMB Volume 'ssd' not found."
    echo "Press any key to exit..."
    read -n 1
    exit 1
fi

# 2. Create the folder if missing
mkdir -p "$noteDir"

# 3. Create file if missing
if [ ! -f "$noteFilename" ]; then
    echo """---
tags:
- daily
---
![[Daily.base]]
## Notes""" > "$noteFilename"

fi

# 4. Launch nvim
$NVIM_BIN -c "norm Go" \
    -c "norm Go###### $(date +%H:%M)" \
    -c "norm o" \
    -c "norm zz" \
    -c "startinsert" "$noteFilename"
