{
  "$schema": "https://opencode.ai/config.json",
  // Ordered rules; the last match wins. Narrow exceptions must come after the
  // broader rules they override, or they silently lose.
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },

    // Secret material. The *.env.example allow at the end is mandatory: the
    // *.env deny above would otherwise make committing an example file
    // impossible.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*auth.json", "effect": "deny" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.pypirc", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // Trusted-local delivery: normal edits, checks, branches, commits and feature
    // integration inherit V2's allow default. Kickoff supplies authorization;
    // these rules are guardrails, not a sandbox or a branch-aware policy.
    // Keep V2's default external-directory ask and its narrow managed skill /
    // tool-output exceptions. Repeating a broad ask here would override them.
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*credentials*", "effect": "deny" },
    { "action": "edit", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "edit", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*auth.json", "effect": "deny" },
    { "action": "edit", "resource": "*.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "*.pypirc", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    // Manual reads; restrictive agents repeat these after their shell deny/ask.
    { "action": "shell", "resource": "man *", "effect": "allow" },
    { "action": "shell", "resource": "MANPAGER=cat PAGER=cat man *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
    { "action": "shell", "resource": "git switch main *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout main *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -f main *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D main *", "effect": "deny" },
    // Match the protected ref as a token/destination, not substrings such as domain.
    { "action": "shell", "resource": "git push * main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * +main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * refs/heads/main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * +refs/heads/main *", "effect": "deny" },
    { "action": "shell", "resource": "git push *:main *", "effect": "deny" },
    { "action": "shell", "resource": "git push *:refs/heads/main *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean -f*", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove --force *", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove -f *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm -fr *", "effect": "ask" },
    { "action": "shell", "resource": "rm -r -f *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },

    // draw.io opens a browser tab. Denied everywhere, re-allowed per agent.
    // Any future global allow must go ABOVE this line, never below.
    { "action": "drawio_*", "resource": "*", "effect": "deny" }
  ],
  // Caps what a single tool result can persist into the database.
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 16384
  },
  "watcher": {
    "ignore": ["**/node_modules/**", "**/.git/**"]
  },
  "mcp": {
    "servers": {
      "obsidian": {
        "type": "remote",
        "url": "https://127.0.0.1:27124/mcp/",
        "headers": {
          "Authorization": "Bearer {env:OBS_MCP_TOKEN}"
        },
        "oauth": false
      },
      "brave-search": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec \"$HOME/.config/opencode/node_modules/.bin/mcp-server-brave-search\" \"$@\"",
          "--"
        ],
        "environment": {
          "BRAVE_API_KEY": "{env:BRAVE_SEARCH_TOKEN}"
        }
      },
      "drawio": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec \"$HOME/.config/opencode/node_modules/.bin/drawio-mcp\" \"$@\"",
          "--"
        ]
      }
    }
  }
}
